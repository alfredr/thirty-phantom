# Serve the game from the container image. The box server's proxy terminates TLS and forwards plain HTTP here.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Cache assets with Vite content hashes for one year as immutable.
	# Revalidate other files, including index.html, levels, and models.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	@unhashed not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"
}
