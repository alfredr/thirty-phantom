# Static host for thirty-phantom.com. deploy/setup-server.sh installs this as
# /etc/caddy/Caddyfile. Caddy gets and renews the certificates itself and
# redirects plain HTTP to HTTPS.
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

thirty-phantom.com {
	root * /srv/thirty-phantom/current
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Vite names what it emits name-<hash>.ext, so those can be cached forever.
	# Everything else (index.html, levels, models) revalidates on every load.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	@unhashed not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"
}

www.thirty-phantom.com {
	redir https://thirty-phantom.com{uri} permanent
}
