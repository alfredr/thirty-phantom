# Serve thirty-phantom.com from the active release. setup-server.sh installs
# this file as /etc/caddy/Caddyfile. Caddy manages TLS certificates and
# redirects HTTP requests to HTTPS.
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

thirty-phantom.com {
	root * /srv/thirty-phantom/current
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Cache assets with Vite content hashes for one year as immutable.
	# Revalidate other files, including index.html, levels, and models.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	@unhashed not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"
}

www.thirty-phantom.com {
	redir https://thirty-phantom.com{uri} permanent
}
