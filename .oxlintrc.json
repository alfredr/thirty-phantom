{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "jsPlugins": ["@stylistic/eslint-plugin", "./tools/lint/rules.mjs"],
  "categories": { "correctness": "off" },
  "rules": {
    "curly": ["error", "all"],
    "phantom/no-instanceof": "error",
    "@stylistic/padding-line-between-statements": ["error",
      { "blankLine": "always", "prev": "*", "next": "multiline-block-like" },
      { "blankLine": "any", "prev": ["const", "let"], "next": "multiline-block-like" },
      { "blankLine": "always", "prev": "multiline-block-like", "next": "*" }
    ],
    "import/first": ["error", "absolute-first"],
    "import/no-duplicates": "error",
    "import/extensions": ["error", "ignorePackages", {
      "checkTypeImports": true,
      "ts": "never", "js": "never", "mjs": "never", "css": "always"
    }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{ "group": ["../*"], "message": "Import across folders from '@/...' (rooted at src/); './' is for the same folder." }]
        }]
      }
    },
    {
      "files": ["tools/**/*.{ts,mjs}", "tests/**/*.mjs", "vite.config.ts", "src/world/schema/**/*.ts"],
      "rules": {
        "import/extensions": ["error", "always", { "ignorePackages": true, "checkTypeImports": true }],
        "no-restricted-imports": "off"
      }
    }
  ]
}
