{
  "name": "30-phantom-codys",
  "version": "0.1.0",
  "private": true,
  "description": "A haunted parking garage game built with Three.js and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint src tools tests vite.config.ts --deny-warnings",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "preview": "vite preview",
    "deploy": "npm run build && deploy/deploy.sh"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "typebox": "^1.3.34",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  }
}
